

# ============================================================
# Clerk API Configuration (Real Working Active User Graphs)
# Update with your Clerk credentials for each project.
# You will also set these in Cloudflare Pages Dashboard -> Settings -> Environment variables.
# ============================================================

# FreePDFly (https://www.freepdfly.com)
CLERK_FREEPDFLY_PROJECT_NAME="FreePDFly"
CLERK_FREEPDFLY_PUBLISHABLE_KEY=
CLERK_FREEPDFLY_SECRET_KEY=

# ClickForNothing (https://clickfornothing.com)
CLERK_CLICKFORNOTHING_PROJECT_NAME="ClickForNothing"
CLERK_CLICKFORNOTHING_PUBLISHABLE_KEY=
CLERK_CLICKFORNOTHING_SECRET_KEY=

# SendVirtualGift (https://sendvirtualgift.com)
CLERK_SENDVIRTUALGIFT_PROJECT_NAME="SendVirtualGift"
CLERK_SENDVIRTUALGIFT_PUBLISHABLE_KEY=
CLERK_SENDVIRTUALGIFT_SECRET_KEY=
