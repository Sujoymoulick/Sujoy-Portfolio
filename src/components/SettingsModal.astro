<div class="modal-backdrop" id="settingsModal">
  <div class="modal-card">
    <div class="modal-header">
      <h3 style="font-size: 16px; font-weight: 700;">Settings</h3>
      <button class="icon-btn" id="closeSettingsBtn" title="Close settings">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="modal-body">
      <div class="setting-row">
        <div>
          <strong style="font-size: 14px; display: block;">Theme</strong>
          <span style="font-size: 12px; color: var(--text-secondary);">Choose between dark and light appearance</span>
        </div>
        <select class="setting-select" id="themeSelect">
          <option value="dark">Dark (ChatGPT Default)</option>
          <option value="light">Light Mode</option>
        </select>
      </div>

      <div class="setting-row">
        <div>
          <strong style="font-size: 14px; display: block;">Speech Synthesis (TTS)</strong>
          <span style="font-size: 12px; color: var(--text-secondary);">Read answers aloud with system voice</span>
        </div>
        <span style="color: var(--accent-green); font-size: 13px; font-weight: 600;">Enabled</span>
      </div>

      <div class="setting-row">
        <div>
          <strong style="font-size: 14px; display: block;">Speech Recognition (STT)</strong>
          <span style="font-size: 12px; color: var(--text-secondary);">Microphone voice input via Web Speech API</span>
        </div>
        <span style="color: var(--accent-green); font-size: 13px; font-weight: 600;">Ready</span>
      </div>
    </div>
  </div>
</div>
