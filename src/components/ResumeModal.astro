---
import { portfolioData } from '../data/portfolioData';
---

<div class="modal-backdrop" id="resumeModal">
  <div class="modal-card resume-modal-card">
    <div class="modal-header">
      <div class="resume-modal-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="resume-icon">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
        <div>
          <h3 style="font-size: 16px; font-weight: 700;">{portfolioData.name} — Resume</h3>
          <span style="font-size: 12px; color: var(--text-secondary);">Verified Developer Curriculum Vitae</span>
        </div>
      </div>
      <button class="icon-btn" id="closeResumeBtn" title="Close resume preview">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="modal-body resume-modal-body">
      <!-- PDF Viewer Frame -->
      <div class="resume-frame-wrapper">
        <iframe
          src="/Resume.pdf#view=FitH"
          class="resume-iframe"
          title="Sujoy Moulick Resume Preview"
          loading="lazy"
        ></iframe>
      </div>

      <!-- Action Toolbar -->
      <div class="resume-actions-footer">
        <a
          href="/Resume.pdf"
          download="Sujoy_Moulick_Resume.pdf"
          class="action-btn-primary download-btn"
          id="modalDownloadResumeBtn"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download PDF Resume</span>
        </a>

        <a
          href="/Resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="action-btn-secondary"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          <span>Open Full Screen</span>
        </a>

        <a
          href={portfolioData.github}
          target="_blank"
          rel="noopener noreferrer"
          class="action-btn-secondary"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
          <span>GitHub</span>
        </a>

        <a
          href={portfolioData.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="action-btn-secondary"
        >
          <span>LinkedIn</span>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .resume-modal-card {
    max-width: 820px;
    width: 94%;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
  }

  .resume-modal-title {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .resume-icon {
    color: var(--accent-green);
    flex-shrink: 0;
  }

  .resume-modal-body {
    padding: 16px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow-y: auto;
    flex: 1;
  }

  .resume-frame-wrapper {
    width: 100%;
    height: 60vh;
    min-height: 380px;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-medium);
    background: #ffffff;
  }

  .resume-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .resume-actions-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    flex-wrap: wrap;
    padding-top: 8px;
    border-top: 1px solid var(--border-subtle);
  }

  @media (max-width: 768px) {
    .resume-modal-card {
      max-height: 88vh;
      width: 100%;
      border-radius: var(--radius-xl) var(--radius-xl) 0 0;
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }

    .resume-frame-wrapper {
      height: 48vh;
      min-height: 240px;
    }

    .resume-actions-footer {
      flex-direction: column;
      gap: 8px;
    }

    .resume-actions-footer a {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }

</style>
