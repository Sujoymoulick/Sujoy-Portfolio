---
import { portfolioData } from '../data/portfolioData';
---

<div class="chat-scroll-area" id="chatScrollArea">
  <!-- Welcome Hero (shown when chat is empty) -->
  <div class="welcome-hero" id="welcomeHero">
    <div class="hero-sparkle-logo">
      <img src="/sujoy-profile-square.jpg" alt="Sujoy Moulick Profile" class="hero-logo-img" />
    </div>
    <h1 class="hero-title">What would you like to know about Sujoy?</h1>
    <p class="hero-subtitle">
      Ask questions about {portfolioData.name}'s education at UEM Jaipur, work experience, tech stack, or shipped products like FreePDFLY.
    </p>

    <!-- 4 Prompt Suggestion Cards -->
    <div class="prompt-cards-grid">
      {
        portfolioData.suggestedPrompts.map((item) => (
          <button class="prompt-card" data-prompt={item.prompt}>
            <div class="prompt-card-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            </div>
            <div class="prompt-card-title">{item.title}</div>
            <div class="prompt-card-desc">{item.prompt}</div>
          </button>
        ))
      }
    </div>
  </div>

  <!-- Messages List (populated by chatApp.ts) -->
  <div class="messages-container" id="messagesContainer"></div>
</div>
