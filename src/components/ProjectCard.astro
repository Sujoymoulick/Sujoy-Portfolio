---
import MiniChart from './MiniChart.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const hasLink = Boolean(project.url);
const isImageLogo = project.icon.startsWith('/') || project.icon.includes('.');
---

<div class="project-card">
  <a 
    href={project.url || '#'} 
    target={hasLink ? "_blank" : "_self"} 
    rel={hasLink ? "noopener noreferrer" : ""} 
    class="project-card-link"
  >
    <div class="card-header">
      <div class="card-title-group">
        <div class="project-icon-box">
          {isImageLogo ? (
            <img src={project.icon} alt={project.name} width="32" height="32" class="project-icon-img" />
          ) : (
            <span class="project-icon">{project.icon}</span>
          )}
        </div>
        <div class="title-details">
          <h3 class="project-name">{project.name}</h3>
        </div>
      </div>

      <div class="card-badges-wrapper">
        {project.isClerkVerified && (
          <div class="clerk-verified-badge" title="Active user metrics verified by Clerk">
            <svg class="clerk-verified-icon" width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M8.603 3.799A4.49 4.49 0 0112 2.25c1.357 0 2.573.6 3.397 1.549a4.49 4.49 0 013.498 1.307 4.491 4.491 0 011.307 3.497A4.49 4.49 0 0121.75 12a4.49 4.49 0 01-1.549 3.397 4.491 4.491 0 01-1.307 3.497 4.491 4.491 0 01-3.497 1.307A4.49 4.49 0 0112 21.75a4.49 4.49 0 01-3.397-1.549 4.49 4.49 0 01-3.498-1.306 4.491 4.491 0 01-1.307-3.498A4.49 4.49 0 012.25 12c0-1.357.6-2.573 1.549-3.397a4.49 4.49 0 011.307-3.497 4.49 4.49 0 013.497-1.307zm7.007 6.387a.75.75 0 10-1.22-.872l-3.236 4.53-1.471-1.47a.75.75 0 00-1.06 1.06l2.121 2.122a.75.75 0 001.14-.094l3.726-5.276z" />
            </svg>
            <span class="clerk-badge-text">Verified by Clerk</span>
          </div>
        )}
        <div class="card-badge">
          <span class="badge-text">{project.badge}</span>
        </div>
      </div>
    </div>

    <p class="project-description">{project.description}</p>

    <!-- Mini Chart Section -->
    <div class="chart-wrapper">
      <MiniChart 
        dataPoints={project.dataPoints} 
        yMin={project.yMin} 
        yMax={project.yMax} 
        months={project.months}
        rawCounts={project.rawCounts}
        chartId={project.id}
      />
    </div>
  </a>
</div>

<style>
  .project-card {
    background-color: var(--card-bg);
    border-radius: 18px;
    padding: 1.25rem 1.35rem 1rem 1.35rem;
    box-shadow: var(--card-shadow);
    border: 1px solid var(--card-border);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease, border-color 0.2s ease;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .project-card:hover {
    transform: translateY(-2.5px);
    box-shadow: var(--card-shadow-hover);
  }

  .project-card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .card-title-group {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .project-icon-box {
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    max-width: 36px;
    max-height: 36px;
    border-radius: 10px;
    background-color: var(--icon-box-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden !important;
    padding: 3px;
    border: 1px solid var(--icon-box-border);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
    box-sizing: border-box;
  }

  .project-icon-img {
    width: 28px !important;
    height: 28px !important;
    max-width: 28px !important;
    max-height: 28px !important;
    object-fit: contain !important;
    border-radius: 4px;
    display: block !important;
    margin: auto;
  }

  .project-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 0;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .card-badges-wrapper {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .clerk-verified-badge {
    background-color: rgba(99, 102, 241, 0.08);
    color: #4F46E5;
    border: 1px solid rgba(99, 102, 241, 0.22);
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.68rem;
    font-weight: 600;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    line-height: 1;
    letter-spacing: -0.01em;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  html.dark .clerk-verified-badge {
    background-color: rgba(99, 102, 241, 0.16);
    color: #818CF8;
    border-color: rgba(99, 102, 241, 0.32);
  }

  .clerk-verified-icon {
    width: 11px;
    height: 11px;
    color: #4F46E5;
    flex-shrink: 0;
  }

  html.dark .clerk-verified-icon {
    color: #818CF8;
  }

  .card-badge {
    background-color: rgba(99, 102, 241, 0.12);
    color: #6366F1;
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.725rem;
    font-weight: 600;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .project-card:nth-child(even) .card-badge {
    background-color: rgba(245, 181, 43, 0.18);
    color: #D97706;
  }

  .project-description {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0.45rem 0 0.25rem 0;
    line-height: 1.4;
    font-weight: 400;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .chart-wrapper {
    margin-top: auto;
    padding-top: 0.25rem;
  }
</style>
