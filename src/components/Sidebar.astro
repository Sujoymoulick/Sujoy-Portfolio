---
import { portfolioData } from '../data/portfolioData';
---

<aside class="sidebar" id="sidebar">
  <!-- Sidebar Header -->
  <div class="sidebar-header">
    <button class="new-chat-btn" id="newChatBtn" title="Start a new chat">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 5v14M5 12h14" />
      </svg>
      <span>New chat</span>
    </button>
    <button class="icon-btn" id="toggleSidebarBtn" title="Toggle sidebar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="9" y1="3" x2="9" y2="21"></line>
      </svg>
    </button>
  </div>

  <!-- Search Chats -->
  <div class="sidebar-search-box">
    <div class="search-input-wrapper">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" id="sidebarSearchInput" placeholder="Search conversations..." />
    </div>
  </div>

  <!-- Chat History List -->
  <div class="sidebar-history" id="sidebarHistory">
    <!-- Populated dynamically by chatApp.ts -->
  </div>

  <!-- Sidebar Footer / User Profile -->
  <div class="sidebar-footer">
    <button class="user-profile-btn" id="userProfileBtn" title="Settings and Profile">
      <div class="user-info">
        <div class="user-avatar">
          <img src="/sujoy-profile-square.jpg" alt="Sujoy Moulick" class="user-avatar-img" />
        </div>
        <div class="user-details">
          <span class="user-name">Visitor</span>
          <span class="user-plan">Portfolio Pro | Online</span>
        </div>
      </div>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="1"></circle>
        <circle cx="19" cy="12" r="1"></circle>
        <circle cx="5" cy="12" r="1"></circle>
      </svg>
    </button>
  </div>
</aside>

<div class="sidebar-backdrop" id="sidebarBackdrop"></div>
