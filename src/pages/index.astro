---
import Layout from '../layouts/Layout.astro';
import ProfilePanel from '../components/ProfilePanel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ResumeModal from '../components/ResumeModal.astro';
import MotionGrid from '../components/ui/motion-grid';
import { getProjectsData } from '../data/projects';
import '../styles/global.css';

const projects = await getProjectsData();
---

<Layout title="Sujoy Moulick — Full-Stack Developer & Indie Hacker Portfolio">
  <div class="motion-grid-bg">
    <MotionGrid client:load speed="25s" opacity={0.08} lineColor="245, 181, 43" backgroundColor="transparent" enableGlow={false} className="w-full h-full min-h-screen" />
  </div>

  <main class="portfolio-container">
    <div class="portfolio-layout">
      <!-- Left Column: Complete Personal & Professional Profile -->
      <div class="sticky-sidebar">
        <ProfilePanel />
      </div>

      <!-- Right Column: 2-Column Project Dashboard -->
      <section class="dashboard-section" aria-label="Projects Dashboard">
        <div class="dashboard-grid">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    </div>
  </main>

  <!-- Resume Preview & Download Modal (Desktop & Mobile) -->
  <ResumeModal />
</Layout>
